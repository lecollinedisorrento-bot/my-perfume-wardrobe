# ── AI provider ────────────────────────────────────────────────
# The key stays on the server. It is never sent to the browser.
# Leave empty to run the app without AI (the UI says so clearly).
ANTHROPIC_API_KEY=
# Optional overrides
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# Max AI requests per client IP per 10 minutes
AI_RATE_LIMIT=40

# ── Server ─────────────────────────────────────────────────────
PORT=8787
